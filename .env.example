# Copy to your host's secret/variable settings. Never commit real values.
# Staging and production use SEPARATE databases, Stripe modes and GTM containers.

APP_ENV=staging                          # development | staging | production
DATABASE_URL=postgresql://user:pass@host:5432/meridian
PUBLIC_BASE_URL=https://staging.example.com
SECRET_KEY=                              # python -m app.security new-secret
ADMIN_PASSWORD_HASH=                     # python -m app.security hash-password
OWNER_EMAIL=                             # where new reservation alerts go

# --- payments (Stripe-hosted Checkout; payment methods are chosen in the Stripe Dashboard)
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=                       # sk_test_/rk_test_ in staging; live keys only in production
STRIPE_WEBHOOK_SECRET=                   # whsec_... for https://<domain>/api/webhooks/stripe
STRIPE_PAYMENT_METHOD_CONFIGURATION=     # optional pmc_...
STRIPE_EXCLUDED_METHODS=us_bank_account  # delayed bank debits don't suit short holds
PAYMENT_METHODS_DISPLAY=card,apple_pay,google_pay,link   # keep in sync with the Dashboard

# --- reservations
MIN_NOTICE_MINUTES=180                   # earliest pickup accepted as a request
INSTANT_MIN_NOTICE_MINUTES=480           # earliest pickup reserved instantly
INSTANT_HOLD_MINUTES=35                  # slot held while the client pays (>= 31)
HOLD_MINUTES=360                         # slot held after owner approval
MAX_DAILY_MINUTES=660                    # committed vehicle time per day, one chauffeur
FREE_CANCEL_HOURS=24

# --- tracking
TRACKING_ENABLED=false
TRACKER_PHONE_ID=                        # Traccar Client "device identifier" (long random)
TRACKER_VEHICLE_ID=                      # in-car tracker uniqueId (optional, later)
TRACCAR_FORWARD_TOKEN=                   # shared secret for Traccar server forwarding (optional)
STALE_AFTER_SECONDS=60
TRACKING_RETENTION_HOURS=0               # 0 = delete positions when the trip ends
MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/light-v11/tiles/256/{z}/{x}/{y}@2x?access_token=pk...
MAP_ATTRIBUTION=© Mapbox © OpenStreetMap

# --- email (Postmark). Outside production only EMAIL_ALLOWLIST receives mail.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=reservations@example.com
EMAIL_ALLOWLIST=you@example.com

# --- analytics (optional)
GTM_CONTAINER_ID=                        # GTM-XXXXXXX
GA4_MEASUREMENT_ID=                      # G-XXXXXXX (server-side purchase events use this too)
GA4_API_SECRET=                          # GA4 Admin > Data streams > Measurement Protocol API secrets

LEGAL_PAGES_APPROVED=false
